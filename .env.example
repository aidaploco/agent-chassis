# Model providers. Tiers accept any pydantic-ai model string —
# provider-prefixed, e.g. openai:gpt-5.4-mini-2026-03-17 or
# anthropic:claude-opus-4-8. Guardrails and the eval judge use the same
# provider-prefixed form (chassis helper, no agent framework involved).
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # only if a tier/guardrail names anthropic:*

# MODEL_TIER_LIGHT=openai:gpt-4o-mini
# MODEL_TIER_STANDARD=openai:gpt-5.4-mini-2026-03-17
# MODEL_TIER_FRONTIER=            # no default — a manifest requesting
                                  # frontier fails loud until this is set

TEMPORAL_PAYLOAD_CODEC_KEY=  # openssl rand -base64 32

# Channel auth (D21). Comma-separated token:principal pairs; the principal
# is the audited approver identity. Unset = local dev: /v1/messages serves
# anonymously (logged), /v1/tasks and /v1/approvals are disabled.
# HTTP_BEARER_TOKENS=s3cret-token:aida

# Slack inbound HMAC verification (D21); unset accepts unsigned webhooks
# with a warning (local dev only).
# SLACK_SIGNING_SECRET=

# --- Everything below is optional; defaults live in config.py ---------------

# Role artifacts. docker-compose sets both from ROLE_DIR; set them yourself
# when running the api/worker outside compose.
# MANIFEST_PATH=./examples/skeleton/manifest.yaml
# PACKS_DIR=./examples/skeleton/packs

# Temporal connection (compose overrides these inside the containers).
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=agent-chassis
# TEMPORAL_PAYLOAD_CODEC_KEY_ID=default   # stamped on payloads for key rotation

# Memory substrate (D8). Unset = the role runs memory-less. Compose sets it
# inside the containers.
# POSTGRES_URL=postgresql://chassis:chassis@localhost:5433/chassis
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# Tracing (D19). Unset = tracing off. Full OTLP/HTTP traces URL; headers are
# "k=v,k2=v2" (e.g. a Logfire write token). PHOENIX_COLLECTOR_ENDPOINT is a
# legacy alias for the endpoint.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=<token>

# Slack-shaped push target; unset disables the outbound sender.
# SLACK_WEBHOOK_URL=

# CONVERSATION_IDLE_SECONDS=3600   # idle timeout before a conversation completes
# TENANT=local                     # correlation label only, never isolation (D16)
