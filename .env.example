# Model providers. Tiers accept any pydantic-ai model string —
# provider-prefixed, e.g. openai:gpt-5.4-mini-2026-03-17 or
# anthropic:claude-opus-4-8. Guardrails and the eval judge use the same
# provider-prefixed form (chassis helper, no agent framework involved).
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # only if a tier/guardrail names anthropic:*

# MODEL_TIER_LIGHT=openai:gpt-4o-mini
# MODEL_TIER_STANDARD=openai:gpt-5.4-mini-2026-03-17
# MODEL_TIER_FRONTIER=            # no default — a manifest requesting
                                  # frontier fails loud until this is set

TEMPORAL_PAYLOAD_CODEC_KEY=  # openssl rand -base64 32

# Channel auth (D21). Comma-separated token:principal pairs; the principal
# is the audited approver identity. Unset = local dev: /v1/messages serves
# anonymously (logged), /v1/tasks and /v1/approvals are disabled.
# HTTP_BEARER_TOKENS=s3cret-token:aida

# Slack inbound HMAC verification (D21); unset accepts unsigned webhooks
# with a warning (local dev only).
# SLACK_SIGNING_SECRET=
