# Server-side only (never sent to the browser). Must match CONSOLE_DEV_TOKEN in
# docker-compose.console.yml (default: dev-console-token).
CONSOLE_TOKEN=dev-console-token
# The Host header values this console answers to (anything else gets a 403: a defence
# against DNS rebinding). Default: 127.0.0.1:3100,localhost:3100. Set it if you change the
# port or reach the console by another name; keep it to names that point at this machine.
# CONSOLE_ALLOWED_HOSTS=127.0.0.1:3100,localhost:3100
# Optional: a different employees file (same shape as employees.json).
# CONSOLE_EMPLOYEES=./employees.json
